# Copy to .env and fill in. `node scripts/hash-password.mjs` prints SESSION_SECRET and ADMIN_PASSWORD_HASH.
SESSION_SECRET=
ADMIN_USER=tirok
ADMIN_PASSWORD_HASH=

# Where the "site" link in the editor points
SITE_URL=https://portfolio.tirok.ir

# SQLite file + uploaded images live here (the Docker image uses /data, mounted as a volume)
DATA_DIR=./data

# Only for plain-http local testing: lets the login cookie work without https
# INSECURE_COOKIES=1
