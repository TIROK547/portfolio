+/* ----------------------------------------------------------------- visits */
+
+// Real, site-wide counter (shared table, not per-browser localStorage). Starts at 547
+// to keep the number the site has always shown; callers increment once per session.
+export function bumpVisitCount(): number {
+  const db = getDb()
+  const row = db.prepare("SELECT value FROM settings WHERE key = 'visits'").get() as { value: string } | undefined
+  const current = row ? parseInt(row.value, 10) || 0 : 547
+  const next = current + 1
+  db.prepare("INSERT INTO settings (key, value) VALUES ('visits', ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value")
+    .run(String(next))
+  return next
+}
+
+export function getVisitCount(): number {
+  const row = getDb().prepare("SELECT value FROM settings WHERE key = 'visits'").get() as { value: string } | undefined
+  return row ? parseInt(row.value, 10) || 547 : 547
+}
+
+/** ISO timestamp of the most recently published post, or null if there isn't one yet. */
+export function getLastUpdated(): string | null {
+  const row = getDb()
+    .prepare("SELECT MAX(updated_at) AS d FROM posts WHERE status = 'published'")
+    .get() as { d: string | null }
+  return row.d
+}
