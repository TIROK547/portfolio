--- /dev/null
+++ b/app/api/visits/route.ts
@@ -0,0 +1,31 @@
+import { NextRequest, NextResponse } from 'next/server'
+import { bumpVisitCount, getVisitCount } from '@/lib/db'
+import { rateLimited } from '@/lib/rate-limit'
+
+export const runtime = 'nodejs'
+
+/** Read-only: current site-wide total. */
+export async function GET() {
+  return NextResponse.json({ count: getVisitCount() })
+}
+
+/**
+ * Called once per browser session (see Footer.tsx). This is a real, shared counter backed by
+ * SQLite — not localStorage — so every visitor sees the same number. Rate-limited per IP since
+ * it's a public, unauthenticated endpoint.
+ */
+export async function POST(req: NextRequest) {
+  const origin = req.headers.get('origin')
+  try {
+    if (!origin || new URL(origin).host !== req.headers.get('host')) throw new Error()
+  } catch {
+    return NextResponse.json({ error: 'bad origin' }, { status: 403 })
+  }
+
+  const ip = req.headers.get('x-forwarded-for')?.split(',')[0].trim() || 'unknown'
+  if (rateLimited(`visit:${ip}`, 20, 60 * 60 * 1000)) {
+    return NextResponse.json({ count: getVisitCount() })
+  }
+
+  return NextResponse.json({ count: bumpVisitCount() })
+}
