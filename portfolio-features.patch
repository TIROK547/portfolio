+++ b/INSTALL_DEPS.md
@@ -0,0 +1,19 @@
+# New npm dependencies required
+
+Two packages need to be added to `package.json`:
+
+```bash
+npm install archiver adm-zip
+npm install --save-dev @types/archiver @types/adm-zip
+```
+
+## Why
+
+| Package | Used in | Purpose |
+|---|---|---|
+| `archiver` | `app/api/admin/backup/route.ts` | Streams a zip of `site.db` + `uploads/` as a download |
+| `adm-zip` | `app/api/admin/restore/route.ts` | Reads an uploaded zip and extracts it synchronously |
+| `@types/archiver` | dev | TypeScript types for archiver |
+| `@types/adm-zip` | dev | TypeScript types for adm-zip |
+
+Both are pure-JS, no native bindings — they work fine inside the Docker image without any extra build steps.
diff --git a/app/api/admin/backup/route.ts b/app/api/admin/backup/route.ts
new file mode 100644
index 0000000..7d1ab4c
--- /dev/null
+++ b/app/api/admin/backup/route.ts
@@ -0,0 +1,74 @@
+import { NextRequest, NextResponse } from "next/server";
+import { cookies } from "next/headers";
+import { verifySession } from "@/lib/auth";
+import { createReadStream, statSync, readdirSync } from "fs";
+import { join } from "path";
+import { createGzip } from "zlib";
+import { PassThrough } from "stream";
+import archiver from "archiver";
+
+const DATA_DIR = process.env.DATA_DIR ?? "./data";
+
+export async function GET(req: NextRequest) {
+  // Auth check — same pattern as every other admin route
+  const cookieStore = await cookies();
+  const session = cookieStore.get("session")?.value;
+  if (!(await verifySession(session))) {
+    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  }
+
+  const dbPath = join(DATA_DIR, "site.db");
+  const uploadsPath = join(DATA_DIR, "uploads");
+
+  // Verify DB exists before we start streaming
+  try {
+    statSync(dbPath);
+  } catch {
+    return NextResponse.json({ error: "Database not found" }, { status: 500 });
+  }
+
+  const date = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
+  const filename = `portfolio-backup-${date}.zip`;
+
+  // Build the zip via a PassThrough stream so we can hand it to NextResponse
+  const pass = new PassThrough();
+  const archive = archiver("zip", { zlib: { level: 6 } });
+
+  archive.on("error", (err) => {
+    console.error("[backup] archiver error:", err);
+    pass.destroy(err);
+  });
+
+  archive.pipe(pass);
+
+  // Add the SQLite database
+  archive.file(dbPath, { name: "site.db" });
+
+  // Add uploads directory (may not exist on a fresh install)
+  try {
+    readdirSync(uploadsPath);
+    archive.directory(uploadsPath, "uploads");
+  } catch {
+    // uploads/ doesn't exist yet — skip silently
+  }
+
+  archive.finalize();
+
+  // Convert Node stream → Web ReadableStream for Next.js
+  const webStream = new ReadableStream({
+    start(controller) {
+      pass.on("data", (chunk) => controller.enqueue(chunk));
+      pass.on("end", () => controller.close());
+      pass.on("error", (err) => controller.error(err));
+    },
+  });
+
+  return new NextResponse(webStream, {
+    status: 200,
+    headers: {
+      "Content-Type": "application/zip",
+      "Content-Disposition": `attachment; filename="${filename}"`,
+      "Cache-Control": "no-store",
+    },
+  });
+}
diff --git a/app/api/admin/restore/route.ts b/app/api/admin/restore/route.ts
new file mode 100644
index 0000000..e2fcc22
--- /dev/null
+++ b/app/api/admin/restore/route.ts
@@ -0,0 +1,137 @@
+import { NextRequest, NextResponse } from "next/server";
+import { cookies } from "next/headers";
+import { verifySession } from "@/lib/auth";
+import { writeFileSync, mkdirSync, existsSync, renameSync } from "fs";
+import { join } from "path";
+import AdmZip from "adm-zip";
+
+const DATA_DIR = process.env.DATA_DIR ?? "./data";
+
+export async function POST(req: NextRequest) {
+  // Auth check
+  const cookieStore = await cookies();
+  const session = cookieStore.get("session")?.value;
+  if (!(await verifySession(session))) {
+    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  }
+
+  const contentType = req.headers.get("content-type") ?? "";
+  if (!contentType.includes("multipart/form-data")) {
+    return NextResponse.json(
+      { error: "Expected multipart/form-data" },
+      { status: 400 }
+    );
+  }
+
+  let formData: FormData;
+  try {
+    formData = await req.formData();
+  } catch {
+    return NextResponse.json(
+      { error: "Could not parse form data" },
+      { status: 400 }
+    );
+  }
+
+  const file = formData.get("backup");
+  if (!file || !(file instanceof Blob)) {
+    return NextResponse.json(
+      { error: "No backup file provided (field name: backup)" },
+      { status: 400 }
+    );
+  }
+
+  if (file.size > 500 * 1024 * 1024) {
+    return NextResponse.json(
+      { error: "Backup file too large (max 500 MB)" },
+      { status: 400 }
+    );
+  }
+
+  // Read zip bytes
+  const buffer = Buffer.from(await file.arrayBuffer());
+
+  let zip: AdmZip;
+  try {
+    zip = new AdmZip(buffer);
+  } catch {
+    return NextResponse.json(
+      { error: "Invalid zip file" },
+      { status: 400 }
+    );
+  }
+
+  // Validate: must contain site.db
+  const entries = zip.getEntries().map((e) => e.entryName);
+  if (!entries.includes("site.db")) {
+    return NextResponse.json(
+      { error: "Invalid backup: site.db not found inside zip" },
+      { status: 400 }
+    );
+  }
+
+  // Security: reject path traversal attempts
+  for (const name of entries) {
+    if (name.includes("..") || name.startsWith("/")) {
+      return NextResponse.json(
+        { error: "Invalid backup: suspicious entry path" },
+        { status: 400 }
+      );
+    }
+  }
+
+  // Ensure DATA_DIR exists
+  mkdirSync(DATA_DIR, { recursive: true });
+
+  const dbDest = join(DATA_DIR, "site.db");
+  const uploadsDest = join(DATA_DIR, "uploads");
+  const dbBackup = `${dbDest}.pre-restore`;
+
+  try {
+    // Snapshot existing DB so we can roll back on failure
+    if (existsSync(dbDest)) {
+      renameSync(dbDest, dbBackup);
+    }
+
+    // Extract site.db
+    const dbEntry = zip.getEntry("site.db")!;
+    writeFileSync(dbDest, dbEntry.getData());
+
+    // Extract uploads/ entries
+    mkdirSync(uploadsDest, { recursive: true });
+    for (const entry of zip.getEntries()) {
+      if (!entry.entryName.startsWith("uploads/")) continue;
+      if (entry.isDirectory) {
+        mkdirSync(join(DATA_DIR, entry.entryName), { recursive: true });
+        continue;
+      }
+      const dest = join(DATA_DIR, entry.entryName);
+      const parent = dest.substring(0, dest.lastIndexOf("/"));
+      mkdirSync(parent, { recursive: true });
+      writeFileSync(dest, entry.getData());
+    }
+
+    // Remove snapshot on success
+    if (existsSync(dbBackup)) {
+      const { unlinkSync } = await import("fs");
+      unlinkSync(dbBackup);
+    }
+
+    return NextResponse.json({
+      ok: true,
+      message: "Restore complete. Reload the page to see updated data.",
+    });
+  } catch (err: any) {
+    // Roll back
+    if (existsSync(dbBackup)) {
+      try {
+        renameSync(dbBackup, dbDest);
+      } catch {}
+    }
+    console.error("[restore] error:", err);
+    return NextResponse.json(
+      { error: `Restore failed: ${err?.message ?? "unknown error"}` },
+      { status: 500 }
+    );
+  }
+}
diff --git a/components/admin/BackupRestore.tsx b/components/admin/BackupRestore.tsx
