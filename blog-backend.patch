+
+/* --------------------------------------------------------------- settings */
+
+export function getSettings(): SiteSettings {
+  const row = getDb().prepare("SELECT value FROM settings WHERE key = 'site'").get() as { value: string } | undefined
+  let stored: unknown = null
+  try {
+    stored = row ? JSON.parse(row.value) : null
